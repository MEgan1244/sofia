<script>
const slides=[...document.querySelectorAll('.slide')];
const dots=document.getElementById('dots');
slides.forEach((_,i)=>{
  const d=document.createElement('i');
  if(i===0)d.className='on';
  dots.appendChild(d);
});
let current=1;
function updateDots(){
  [...dots.children].forEach((d,i)=>d.classList.toggle('on',i===current-1));
}
function goTo(n){
  if(n<1||n>8)return;
  slides.forEach((s,i)=>s.classList.toggle('active',i===n-1));
  current=n; updateDots();
  if(n===3) autoVideoSequence();
}
function restart(){
  document.getElementById('s7').classList.remove('open');
  document.getElementById('nextAfterBlow').style.display='none';
  blown=false;
  document.getElementById('progress').style.width='0%';
  document.getElementById('status').textContent='';
  goTo(1);
}

/* Confetti */
const canvas=document.getElementById('confetti'),ctx=canvas.getContext('2d');
let pieces=[],running=false;
function resize(){canvas.width=document.getElementById('stage').clientWidth;canvas.height=document.getElementById('stage').clientHeight}
resize();addEventListener('resize',resize);
function confetti(){
  for(let i=0;i<180;i++) pieces.push({
    x:Math.random()*canvas.width,y:-10-Math.random()*canvas.height*.35,
    vx:(Math.random()-.5)*4,vy:2+Math.random()*4,
    size:4+Math.random()*6,r:Math.random()*6.28,vr:(Math.random()-.5)*.3,
    color:['#2474d8','#ff7fa8','#ffd166','#70c1ff','#8ac926','#fff'][Math.floor(Math.random()*6)]
  });
  if(!running){running=true;requestAnimationFrame(tick)}
}
function tick(){
  ctx.clearRect(0,0,canvas.width,canvas.height);
  let alive=false;
  pieces.forEach(p=>{
    p.x+=p.vx;p.y+=p.vy;p.vy+=.035;p.r+=p.vr;
    if(p.y<canvas.height+20){alive=true;ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.r);ctx.fillStyle=p.color;ctx.fillRect(-p.size/2,-p.size/3,p.size,p.size*.6);ctx.restore()}
  });
  if(alive)requestAnimationFrame(tick);else{pieces=[];running=false}
}

/* Long press */
let blown=false,holdTimer=null,holdStart=0,raf=null;
const holdBtn=document.getElementById('holdBtn'),progress=document.getElementById('progress'),status=document.getElementById('status');
function startHold(e){
  e.preventDefault();
  if(blown)return;
  holdStart=performance.now();
  function frame(t){
    const pct=Math.min(100,(t-holdStart)/2000*100);
    progress.style.width=pct+'%';
    if(pct>=100){blow();return}
    raf=requestAnimationFrame(frame);
  }
  raf=requestAnimationFrame(frame);
}
function cancelHold(){
  if(raf)cancelAnimationFrame(raf);
  if(!blown)progress.style.width='0%';
}
holdBtn.addEventListener('pointerdown',startHold);
['pointerup','pointercancel','pointerleave'].forEach(e=>holdBtn.addEventListener(e,cancelHold));

function blow(){
  if(blown)return;
  blown=true;
  progress.style.width='100%';
  status.textContent='🎉 The candles are blown out! Make your wish!';
  confetti();
  document.getElementById('nextAfterBlow').style.display='grid';
}

/* Microphone blow detection */
let stream=null,audio=null,analyser=null,micRAF=null;
document.getElementById('micBtn').addEventListener('click',async()=>{
  if(blown)return;
  if(!navigator.mediaDevices?.getUserMedia){
    status.textContent='Microphone is not available here. Use the long-press button.';
    return;
  }
  try{
    status.textContent='Listening... blow into your microphone 💨';
    stream=await navigator.mediaDevices.getUserMedia({audio:true});
    audio=new (window.AudioContext||window.webkitAudioContext)();
    const src=audio.createMediaStreamSource(stream);
    analyser=audio.createAnalyser();analyser.fftSize=512;src.connect(analyser);
    const data=new Uint8Array(analyser.frequencyBinCount);
    let loud=0;
    function listen(){
      if(blown)return;
      analyser.getByteFrequencyData(data);
      let sum=0;for(const v of data)sum+=v;
      const avg=sum/data.length;
      loud=avg>28?loud+1:Math.max(0,loud-1);
      if(loud>7){blow();stopMic();return}
      micRAF=requestAnimationFrame(listen);
    }
    listen();
  }catch(err){
    status.textContent='Microphone permission was not granted. Use the long-press button instead.';
  }
});
function stopMic(){
  if(micRAF)cancelAnimationFrame(micRAF);
  if(stream)stream.getTracks().forEach(t=>t.stop());
  if(audio)audio.close().catch(()=>{});
  stream=null;audio=null;analyser=null;
}

/* Pages 3 → 4 → 5 → 6 play like one short video */
let seqTimer=[];
function clearSequence(){seqTimer.forEach(clearTimeout);seqTimer=[]}
function autoVideoSequence(){
  clearSequence();
  seqTimer.push(setTimeout(()=>goTo(4),1400));
  seqTimer.push(setTimeout(()=>goTo(5),2700));
  seqTimer.push(setTimeout(()=>goTo(6),5000));
}

/* Envelope → letter */
function openEnvelope(){
  const s7=document.getElementById('s7');
  if(s7.classList.contains('open'))return;
  s7.classList.add('open');
  setTimeout(()=>goTo(8),850);
}
</script>
</body>
</html>
'''

